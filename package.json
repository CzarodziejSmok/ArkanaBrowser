{
  "name": "arkana-browser",
  "version": "34.0.0",
  "description": "Przeglądarka z podręcznością i customizajcą w myśli.",
  "author": "CzarodziejSmok",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node check-release.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.arkana.browser",
    "productName": "Arkana Browser",
    "copyright": "Arkana Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "instance.js",
      "preload.js",
      "ffmpeg.js",
      "updater.js",
      "index.html",
      "icon.ico",
      "icon.png",
      "package.json",
      "CHANGELOG.txt"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "artifactName": "Arkana-Browser-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arkana Browser",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CzarodziejSmok",
        "repo": "ArkanaBrowser",
        "releaseType": "release"
      }
    ]
  }
}
